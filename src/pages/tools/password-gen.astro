ed", "heel", "heft", "height", "heir", "held", "helium", "helix", "hello", "helm", "help", "hence", "henna", "herald", "herb", "herd", "here", "hero", "heron", "hick", "hide", "high", "hike", "hill", "hilt", "hind", "hint", "hire", "hiss", "hist", "hive", "hoard", "hobby", "hockey", "hold", "hole", "hollow", "holly", "home", "honey", "honor", "hood", "hoof", "hook", "hoop", "hoot", "hope", "horde", "horn", "horrid", "horse", "hose", "host", "hotel", "hound", "hour", "house", "hover", "huff", "huge", "hull", "human", "humble", "humid", "humor", "hump", "humus", "hunch", "hunger", "hungry", "hunk", "hunt", "hurl", "hurry", "hurt", "hush", "husk", "husky", "hybrid", "hydra", "hyena", "hymn", "hype", "icon", "idea", "ideal", "idiom", "idiot", "idle", "idly", "idol", "igloo", "image", "imbue", "impel", "import", "impose", "imply", "improv", "inch", "income", "incur", "index", "indoor", "induce", "infant", "infer", "inform", "ingot", "injury", "inland", "inlet", "inner", "input", "insane", "insect", "insert", "inside", "insist", "instil", "insult", "insure", "intact", "intake", "intend", "inter", "into", "invade", "invent", "invert", "invest", "invite", "invoke", "inward", "iota", "irate", "iris", "iron", "irony", "island", "isle", "issue", "itch", "item", "ivory", "jacket", "jade", "jail", "jargon", "jaunt", "jazz", "jeep", "jelly", "jerk", "jest", "jewel", "jiffy", "jilt", "jock", "jockey", "join", "joint", "joke", "jolly", "jolt", "journal", "judge", "juice", "juicy", "julep", "july", "jumble", "jump", "jungle", "junior", "junk", "junta", "jury", "just", "jute", "keel", "keen", "keep", "kelp", "kennel", "kept", "kernel", "kettle", "khaki", "kick", "kill", "kiln", "kilt", "kind", "king", "kink", "kiss", "kite", "kitten", "kiwi", "knack", "knee", "knelt", "knife", "knight", "knit", "knob", "knock", "knot", "know", "known", "koala", "kudos", "label", "labor", "lace", "lack", "ladder", "laden", "ladle", "lady", "lagoon", "laity", "lake", "lamb", "lame", "lamp", "lance", "land", "lane", "lanky", "lapel", "lapse", "lard", "large", "lark", "larva", "laser", "lash", "last", "latch", "late", "latent", "latex", "lathe", "latin", "latter", "laugh", "launch", "lava", "lavish", "lawn", "lawyer", "layer", "lazy", "lead", "leaf", "league", "leak", "lean", "leap", "learn", "lease", "leash", "least", "leave", "ledge", "leech", "leer", "left", "legal", "legend", "lemon", "lend", "length", "lens", "lent", "leper", "less", "lesson", "letter", "level", "lever", "levy", "lewd", "liable", "liar", "libel", "licit", "lick", "life", "lift", "light", "like", "lilac", "lily", "limb", "lime", "limit", "limp", "line", "linear", "linen", "liner", "lingo", "link", "lint", "lion", "liquid", "lisp", "list", "listen", "live", "lively", "liver", "livid", "lizard", "load", "loaf", "loan", "lobby", "lobe", "local", "locate", "lock", "locket", "locust", "lodge", "loft", "logic", "logo", "lone", "lonely", "long", "look", "loom", "loop", "loose", "loot", "lord", "lore", "lose", "loss", "lost", "lotion", "loud", "lounge", "louse", "lousy", "love", "lower", "loyal", "lucid", "luck", "lucky", "lull", "lumber", "lump", "lumpy", "lunar", "lunch", "lung", "lurch", "lure", "lurid", "lurk", "lush", "lust", "lute", "luxury", "lying", "lymph", "lynx", "lyre", "lyric"];

        const elements = {
            display: document.getElementById('resultDisplay'),
            strengthBar: document.getElementById('strengthBar'),
            strengthMeter: document.getElementById('strengthMeter'),
            lengthSlider: document.getElementById('lengthSlider'),
            lengthVal: document.getElementById('lengthVal'),
            wordSlider: document.getElementById('wordSlider'),
            wordCountVal: document.getElementById('wordCountVal'),
            generateBtn: document.getElementById('generateBtn'),
            copyBtn: document.getElementById('copyBtn'),
            passwordSettings: document.getElementById('passwordSettings'),
            passphraseSettings: document.getElementById('passphraseSettings'),
            separator: document.getElementById('separator'),
            checks: {
                upper: document.getElementById('useUpper'),
                lower: document.getElementById('useLower'),
                numbers: document.getElementById('useNumbers'),
                symbols: document.getElementById('useSymbols')
            }
        };

        let currentMode = 'password';

        function getRandomInt(max) {
            const array = new Uint32Array(1);
            window.crypto.getRandomValues(array);
            return array[0] % max;
        }

        function generatePassword() {
            const length = parseInt(elements.lengthSlider.value);
            const charset = {
                upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
                lower: 'abcdefghijklmnopqrstuvwxyz',
                numbers: '0123456789',
                symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?'
            };

            let chars = '';
            if (elements.checks.upper.checked) chars += charset.upper;
            if (elements.checks.lower.checked) chars += charset.lower;
            if (elements.checks.numbers.checked) chars += charset.numbers;
            if (elements.checks.symbols.checked) chars += charset.symbols;

            if (!chars) {
                elements.display.textContent = 'Select at least one option';
                updateStrength(0);
                return;
            }

            let result = '';
            for (let i = 0; i < length; i++) {
                result += chars[getRandomInt(chars.length)];
            }
            elements.display.textContent = result;
            
            // Simple strength calc
            let strength = (length / 64) * 100;
            let variety = [elements.checks.upper, elements.checks.lower, elements.checks.numbers, elements.checks.symbols].filter(c => c.checked).length;
            strength = (strength * 0.7) + (variety * 7.5);
            updateStrength(Math.min(strength, 100));
        }

        function generatePassphrase() {
            const count = parseInt(elements.wordSlider.value);
            const sep = elements.separator.value;
            let result = [];
            for (let i = 0; i < count; i++) {
                result.push(words[getRandomInt(words.length)]);
            }
            elements.display.textContent = result.join(sep);
            
            // Passphrase strength is mostly word count
            updateStrength(Math.min((count / 10) * 100, 100));
        }

        function updateStrength(percent) {
            elements.strengthBar.style.width = percent + '%';
            if (percent < 30) elements.strengthBar.style.backgroundColor = 'var(--error)';
            else if (percent < 70) elements.strengthBar.style.backgroundColor = 'var(--warning)';
            else elements.strengthBar.style.backgroundColor = 'var(--success)';
        }

        function handleGenerate() {
            if (currentMode === 'password') generatePassword();
            else generatePassphrase();
        }

        // Event Listeners
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentMode = btn.dataset.tab;
                
                elements.passwordSettings.classList.toggle('hidden', currentMode !== 'password');
                elements.passphraseSettings.classList.toggle('hidden', currentMode !== 'passphrase');
                elements.strengthMeter.classList.toggle('hidden', currentMode === 'passphrase');
                handleGenerate();
            });
        });

        elements.lengthSlider.addEventListener('input', (e) => {
            elements.lengthVal.textContent = e.target.value;
            generatePassword();
        });

        elements.wordSlider.addEventListener('input', (e) => {
            elements.wordCountVal.textContent = e.target.value;
            generatePassphrase();
        });

        elements.generateBtn.addEventListener('click', handleGenerate);
        elements.copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(elements.display.textContent);
            const originalText = elements.copyBtn.textContent;
            elements.copyBtn.textContent = 'Copied!';
            setTimeout(() => elements.copyBtn.textContent = originalText, 2000);
        });

        // Initial generation
        handleGenerate();
    </script>
</body>
</html>