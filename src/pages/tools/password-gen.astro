---
// Tool 2: Password Generator
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Generator - My Tools</title>
    <style>
        :root {
            --primary: #2563eb;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
            --success: #22c55e;
            --warning: #f59e0b;
            --error: #ef4444;
        }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            max-width: 600px;
            width: 100%;
        }
        header {
            margin-bottom: 2rem;
            text-align: center;
        }
        .tool-box {
            background: var(--card);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            border: 1px solid var(--border);
        }
        .tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
            padding-bottom: 0.5rem;
        }
        .tab-btn {
            padding: 0.5rem 1rem;
            border: none;
            background: none;
            cursor: pointer;
            font-weight: 500;
            color: #64748b;
            border-radius: 6px;
        }
        .tab-btn.active {
            background: var(--primary);
            color: white;
        }
        .output-container {
            position: relative;
            margin-bottom: 1.5rem;
        }
        #resultDisplay {
            width: 100%;
            padding: 1.25rem;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-family: monospace;
            font-size: 1.25rem;
            word-break: break-all;
            min-height: 3rem;
            display: flex;
            align-items: center;
            box-sizing: border-box;
        }
        .strength-meter {
            height: 4px;
            background: var(--border);
            margin-top: 0.5rem;
            border-radius: 2px;
            overflow: hidden;
        }
        #strengthBar {
            height: 100%;
            width: 0%;
            transition: width 0.3s, background-color 0.3s;
        }
        .settings {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .setting-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .setting-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
        }
        input[type="range"] { width: 100%; margin-top: 0.5rem; }
        .actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
            margin-top: 1.5rem;
        }
        button {
            padding: 0.75rem 1rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: opacity 0.2s;
        }
        .btn-primary { background: var(--primary); color: white; }
        .btn-outline { background: white; border: 1px solid var(--border); color: var(--text); }
        .back-link { display: inline-block; margin-bottom: 1rem; color: var(--primary); text-decoration: none; }
        .hidden { display: none; }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← All Tools</a>
        <header>
            <h1>Password Generator</h1>
            <p>Generate secure passwords locally in your browser.</p>
        </header>

        <div class="tool-box">
            <div class="tabs">
                <button class="tab-btn active" data-tab="password">Password</button>
                <button class="tab-btn" data-tab="passphrase">Passphrase</button>
            </div>

            <div class="output-container">
                <div id="resultDisplay">Click Generate</div>
                <div class="strength-meter" id="strengthMeter">
                    <div id="strengthBar"></div>
                </div>
            </div>

            <!-- Password Settings -->
            <div id="passwordSettings" class="settings">
                <div class="setting-item">
                    <label>Length: <span id="lengthVal">16</span></label>
                </div>
                <input type="range" id="lengthSlider" min="8" max="64" value="16">
                
                <div class="setting-group">
                    <label><input type="checkbox" id="useUpper" checked> Uppercase</label>
                    <label><input type="checkbox" id="useLower" checked> Lowercase</label>
                    <label><input type="checkbox" id="useNumbers" checked> Numbers</label>
                    <label><input type="checkbox" id="useSymbols" checked> Symbols</label>
                </div>
            </div>

            <!-- Passphrase Settings -->
            <div id="passphraseSettings" class="settings hidden">
                <div class="setting-item">
                    <label>Number of Words: <span id="wordCountVal">4</span></label>
                </div>
                <input type="range" id="wordSlider" min="3" max="10" value="4">
                <div class="setting-item">
                    <label>Separator:</label>
                    <select id="separator">
                        <option value="-">Hyphen (-)</option>
                        <option value=".">Dot (.)</option>
                        <option value="_">Underscore (_)</option>
                        <option value=" ">Space</option>
                    </select>
                </div>
            </div>

            <div class="actions">
                <button class="btn-primary" id="generateBtn">Regenerate</button>
                <button class="btn-outline" id="copyBtn">Copy</button>
            </div>
        </div>
    </div>

    <script>
        // EFF Short Wordlist (Subset for implementation)
        const words = ["acid", "altar", "aroma", "atlas", "audio", "badge", "bagel", "basin", "beard", "bible", "blank", "blast", "blimp", "block", "bloat", "blot", "blunt", "board", "boast", "body", "bond", "bone", "bonus", "book", "booth", "border", "boss", "bottle", "bottom", "bound", "bowl", "box", "boy", "brain", "brand", "brass", "brave", "bread", "break", "brief", "bright", "brisk", "broad", "broil", "broke", "broom", "brown", "browse", "brush", "buck", "budget", "build", "built", "bulb", "bulk", "bumpy", "bunch", "bundle", "bunk", "bunny", "burn", "burst", "bush", "busy", "buyer", "buzz", "cabin", "cable", "cactus", "cage", "cake", "calf", "call", "calm", "camera", "camp", "canal", "candy", "cane", "cannon", "canoe", "canvas", "canyon", "cape", "card", "care", "cargo", "carpet", "carrot", "cart", "case", "cash", "castle", "cause", "cave", "cell", "cement", "center", "chain", "chair", "chalk", "champ", "chance", "change", "chant", "chapel", "charge", "charm", "chart", "chase", "cheap", "check", "cheek", "cheer", "cheese", "chef", "cherry", "chess", "chest", "chew", "chief", "child", "chili", "chill", "chime", "chin", "chip", "choice", "choose", "chop", "chorus", "chose", "chuck", "church", "churn", "cider", "cigar", "cinema", "circle", "city", "civic", "civil", "claim", "clamp", "clap", "clash", "clasp", "class", "claw", "clay", "clean", "clear", "cleat", "clerk", "click", "client", "cliff", "climb", "clip", "cloak", "clock", "clone", "close", "cloth", "cloud", "clover", "clown", "club", "clue", "clump", "coach", "coast", "coat", "cobra", "cocoa", "code", "coffee", "coil", "coin", "cold", "collar", "colon", "colony", "color", "colt", "column", "comb", "combat", "come", "comedy", "comic", "commit", "common", "compel", "comply", "concur", "cone", "confer", "conga", "conic", "consul", "convex", "convey", "convoy", "cook", "cool", "cope", "copper", "copy", "coral", "cord", "core", "cork", "corn", "corner", "corpus", "corral", "cost", "cotton", "couch", "cough", "