---
// Tool 9: Document Scanner (OCR)
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document Scanner - My Tools</title>
    <style>
        :root {
            --primary: #2563eb;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
        }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container { max-width: 800px; width: 100%; }
        header { margin-bottom: 2rem; text-align: center; }
        .tool-box {
            background: var(--card);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            border: 1px solid var(--border);
        }
        .drop-zone {
            border: 2px dashed var(--border);
            border-radius: 8px;
            padding: 2rem;
            text-align: center;
            cursor: pointer;
            transition: border-color 0.2s;
            margin-bottom: 1.5rem;
        }
        .drop-zone:hover, .drop-zone.drag-over {
            border-color: var(--primary);
            background: #eff6ff;
        }
        .controls {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 1rem;
            margin-bottom: 1.5rem;
            align-items: end;
        }
        .field { display: flex; flex-direction: column; gap: 0.5rem; }
        label { font-size: 0.875rem; font-weight: 500; color: #64748b; }
        select, button {
            padding: 0.75rem;
            border-radius: 8px;
            border: 1px solid var(--border);
            font-size: 1rem;
        }
        .btn-primary {
            background: var(--primary);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: 600;
        }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .progress-container {
            margin-bottom: 1.5rem;
            display: none;
        }
        .progress-bar {
            height: 8px;
            background: var(--border);
            border-radius: 4px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.2s;
        }
        .progress-text {
            font-size: 0.8rem;
            color: #64748b;
            margin-top: 0.4rem;
            display: block;
        }

        textarea {
            width: 100%;
            height: 250px;
            padding: 1rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
            resize: vertical;
            box-sizing: border-box;
            margin-bottom: 1rem;
        }
        .actions { display: flex; gap: 0.5rem; }
        .btn-outline { background: white; color: var(--text); cursor: pointer; flex: 1; }
        .back-link { display: inline-block; margin-bottom: 1rem; color: var(--primary); text-decoration: none; }
        canvas { display: none; }
        .hidden { display: none; }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← All Tools</a>
        <header>
            <h1>Document Scanner (OCR)</h1>
            <p>Extract text from images locally. No data leaves your device.</p>
        </header>

        <div class="tool-box">
            <input type="file" id="fileInput" accept="image/*" class="hidden">
            <div id="dropZone" class="drop-zone">
                <p>Click to upload or drag & drop a document image</p>
                <small>(JPG, PNG, WebP supported)</small>
            </div>

            <div class="controls">
                <div class="field">
                    <label>Document Language</label>
                    <select id="langSelect">
                        <option value="eng">English</option>
                        <option value="spa">Spanish</option>
                        <option value="fra">French</option>
                        <option value="deu">German</option>
                        <option value="hin">Hindi</option>
                        <option value="ara">Arabic</option>
                    </select>
                </div>
                <button id="scanBtn" class="btn-primary" disabled>Start Scan</button>
            </div>

            <div id="progressSection" class="progress-container">
                <div class="progress-bar"><div id="progressFill" class="progress-fill"></div></div>
                <span id="progressText" class="progress-text">Initializing OCR...</span>
            </div>

            <textarea id="output" placeholder="Extracted text will appear here..."></textarea>
            
            <div class="actions">
                <button class="btn-outline" id="copyBtn">Copy Text</button>
                <button class="btn-outline" id="downloadBtn">Download .txt</button>
            </div>
            <p style="font-size: 0.8rem; color: #64748b; margin-top: 1rem; font-style: italic;">
                Note: OCR accuracy depends on image quality. Please review the text for errors.
            </p>
        </div>
    </div>

    <canvas id="preProcessCanvas"></canvas>

    <!-- Load Tesseract.js from CDN for instant functionality -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const scanBtn = document.getElementById('scanBtn');
        const output = document.getElementById('output');
        const progressSection = document.getElementById('progressSection');
        const progressFill = document.getElementById('progressFill');
        const progressText = document.getElementById('progressText');
        const canvas = document.getElementById('preProcessCanvas');
        const ctx = canvas.getContext('2d');

        let selectedFile = null;

        // Handle selection
        dropZone.onclick = () => fileInput.click();
        fileInput.onchange = (e) => handleFile(e.target.files[0]);
        
        dropZone.ondragover = (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); };
        dropZone.ondragleave = () => dropZone.classList.remove('drag-over');
        dropZone.ondrop = (e) => {
            e.preventDefault();
            dropZone.classList.remove('drag-over');
            handleFile(e.dataTransfer.files[0]);
        };

        function handleFile(file) {
            if (file && file.type.startsWith('image/')) {
                selectedFile = file;
                dropZone.querySelector('p').textContent = `File selected: ${file.name}`;
                scanBtn.disabled = false;
            }
        }

        async function preProcessImage(file) {
            return new Promise((resolve) => {
                const img = new Image();
                img.onload = () => {
                    canvas.width = img.width;
                    canvas.height = img.height;
                    
                    // Step 1: Draw to canvas
                    ctx.drawImage(img, 0, 0);
                    
                    // Step 2: Preprocessing (Grayscale + Contrast)
                    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    const data = imageData.data;
                    const contrast = 40; // Increase contrast
                    const factor = (259 * (contrast + 255)) / (255 * (259 - contrast));

                    for (let i = 0; i < data.length; i += 4) {
                        // Grayscale
                        const avg = (data[i] + data[i + 1] + data[i + 2]) / 3;
                        
                        // Contrast adjustment
                        const newValue = factor * (avg - 128) + 128;
                        
                        data[i] = data[i+1] = data[i+2] = newValue;
                    }
                    ctx.putImageData(imageData, 0, 0);
                    resolve(canvas.toDataURL());
                };
                img.src = URL.createObjectURL(file);
            });
        }

        scanBtn.onclick = async () => {
            if (!selectedFile) return;

            scanBtn.disabled = true;
            output.value = '';
            progressSection.style.display = 'block';
            
            try {
                progressText.textContent = 'Preprocessing image...';
                const processedImage = await preProcessImage(selectedFile);
                
                const worker = await Tesseract.createWorker(document.getElementById('langSelect').value, 1, {
                    logger: m => {
                        if (m.status === 'recognizing text') {
                            const p = (m.progress * 100).toFixed(0);
                            progressFill.style.width = p + '%';
                            progressText.textContent = `Recognizing text: ${p}%`;
                        }
                    }
                });

                const { data: { text } } = await worker.recognize(processedImage);
                output.value = text;
                
                await worker.terminate();
                progressText.textContent = 'Scan complete!';
            } catch (err) {
                console.error(err);
                alert('An error occurred during scanning.');
            } finally {
                scanBtn.disabled = false;
            }
        };

        // Actions
        document.getElementById('copyBtn').onclick = () => {
            navigator.clipboard.writeText(output.value);
            alert('Text copied to clipboard!');
        };

        document.getElementById('downloadBtn').onclick = () => {
            const blob = new Blob([output.value], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'scanned-text.txt';
            a.click();
        };
    </script>
</body>
</html>