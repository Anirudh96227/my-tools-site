---
// Tool 10: Voice Transcriber
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voice Transcriber - My Tools</title>
    <style>
        :root {
            --primary: #2563eb;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
            --error: #ef4444;
            --success: #22c55e;
        }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container { max-width: 800px; width: 100%; }
        header { margin-bottom: 2rem; text-align: center; }
        .tool-box {
            background: var(--card);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            border: 1px solid var(--border);
        }
        .model-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .model-card {
            border: 2px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: var(--card);
        }
        .model-card:hover { border-color: var(--primary); background: #f0f7ff; }
        .model-card h3 { margin: 0 0 0.5rem 0; color: var(--primary); }
        .model-card p { margin: 0; font-size: 0.85rem; color: #64748b; }
        
        .progress-container {
            margin-bottom: 1.5rem;
            display: none;
        }
        .progress-bar {
            height: 10px;
            background: var(--border);
            border-radius: 5px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.3s;
        }
        .status-text {
            font-size: 0.85rem;
            color: #64748b;
            margin-top: 0.5rem;
            text-align: center;
            display: block;
        }

        .audio-controls {
            display: none;
            flex-direction: column;
            gap: 1.5rem;
            align-items: center;
            margin-bottom: 2rem;
            padding: 2rem;
            background: var(--bg);
            border-radius: 12px;
            border: 1px solid var(--border);
        }
        
        .record-btn {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: none;
            background: var(--error);
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            transition: transform 0.2s;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }
        .record-btn:active { transform: scale(0.95); }
        .record-btn.recording {
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 15px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        .upload-area {
            width: 100%;
            border: 2px dashed var(--border);
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            color: #64748b;
        }

        textarea {
            width: 100%;
            height: 250px;
            padding: 1rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
            resize: vertical;
            box-sizing: border-box;
            margin-bottom: 1rem;
        }
        .actions { display: flex; gap: 0.5rem; }
        .btn-outline {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: white;
            color: var(--text);
            cursor: pointer;
            font-weight: 500;
            flex: 1;
        }
        .back-link { display: inline-block; margin-bottom: 1rem; color: var(--primary); text-decoration: none; }
        .hidden { display: none; }

        @media (max-width: 600px) {
            .model-selector { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← All Tools</a>
        <header>
            <h1>Voice Transcriber</h1>
            <p>On-device audio transcription using Whisper AI.</p>
        </header>

        <div class="tool-box">
            <div id="setupArea">
                <p style="text-align:center; margin-bottom: 1.5rem;">Choose a model. Models are downloaded once and cached in your browser.</p>
                <div class="model-selector">
                    <div class="model-card" onclick="loadModel('Xenova/whisper-tiny.en')">
                        <h3>Quick</h3>
                        <p>English only (40MB)</p>
                    </div>
                    <div class="model-card" onclick="loadModel('Xenova/whisper-base.en')">
                        <h3>Accurate</h3>
                        <p>Better for accents (145MB)</p>
                    </div>
                </div>
            </div>

            <div id="progressSection" class="progress-container">
                <div class="progress-bar"><div id="progressFill" class="progress-fill"></div></div>
                <span id="statusText" class="status-text">Ready to initialize...</span>
            </div>

            <div id="mainControls" class="audio-controls">
                <button id="recordBtn" class="record-btn">REC</button>
                <div class="upload-area" onclick="document.getElementById('audioInput').click()">
                    <span>Or click to upload an audio file</span>
                    <input type="file" id="audioInput" accept="audio/*" class="hidden">
                </div>
            </div>

            <textarea id="output" placeholder="Transcript will appear here..."></textarea>
            
            <div class="actions">
                <button class="btn-outline" id="copyBtn">Copy Text</button>
                <button class="btn-outline" id="downloadBtn">Download .txt</button>
            </div>
        </div>
    </div>

    <script>
        const worker = new Worker('/workers/transcribe-worker.js', { type: 'module' });
        
        const setupArea = document.getElementById('setupArea');
        const progressSection = document.getElementById('progressSection');
        const progressFill = document.getElementById('progressFill');
        const statusText = document.getElementById('statusText');
        const mainControls = document.getElementById('mainControls');
        const recordBtn = document.getElementById('recordBtn');
        const audioInput = document.getElementById('audioInput');
        const output = document.getElementById('output');

        let isRecording = false;
        let mediaRecorder;
        let audioChunks = [];

        window.loadModel = (model) => {
            setupArea.style.display = 'none';
            progressSection.style.display = 'block';
            worker.postMessage({ type: 'load', model });
        };

        worker.onmessage = (e) => {
            const data = e.data;
            if (data.type === 'progress' && data.status === 'progress') {
                progressFill.style.width = data.progress + '%';
                statusText.textContent = `Downloading ${data.file}: ${data.progress.toFixed(1)}%`;
            } else if (data.type === 'status') {
                statusText.textContent = data.message;
            } else if (data.type === 'loaded') {
                progressSection.style.display = 'none';
                mainControls.style.display = 'flex';
                statusText.textContent = 'Model Loaded Successfully';
            } else if (data.type === 'result') {
                output.value += (output.value ? '\n' : '') + data.text.trim();
                statusText.textContent = 'Transcription complete.';
            } else if (data.type === 'error') {
                alert('AI Error: ' + data.message);
                statusText.textContent = 'An error occurred.';
            }
        };

        async function processAudio(blob) {
            statusText.textContent = 'Resampling audio to 16kHz...';
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
            const arrayBuffer = await blob.arrayBuffer();
            const decoded = await audioCtx.decodeAudioData(arrayBuffer);
            
            const offlineCtx = new OfflineAudioContext(1, decoded.duration * 16000, 16000);
            const source = offlineCtx.createBufferSource();
            source.buffer = decoded;
            source.connect(offlineCtx.destination);
            source.start();
            
            const resampled = await offlineCtx.startRendering();
            worker.postMessage({ type: 'transcribe', audio: resampled.getChannelData(0) });
        }

        recordBtn.onclick = async () => {
            if (!isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];
                    mediaRecorder.ondataavailable = (e) => audioChunks.push(e.data);
                    mediaRecorder.onstop = () => processAudio(new Blob(audioChunks));
                    
                    mediaRecorder.start();
                    isRecording = true;
                    recordBtn.textContent = 'STOP';
                    recordBtn.classList.add('recording');
                    statusText.textContent = 'Recording...';
                } catch (err) {
                    alert('Could not access microphone: ' + err.message);
                }
            } else {
                mediaRecorder.stop();
                isRecording = false;
                recordBtn.textContent = 'REC';
                recordBtn.classList.remove('recording');
            }
        };

        audioInput.onchange = (e) => {
            if (e.target.files[0]) processAudio(e.target.files[0]);
        };

        document.getElementById('copyBtn').onclick = () => {
            navigator.clipboard.writeText(output.value);
            alert('Copied to clipboard');
        };

        document.getElementById('downloadBtn').onclick = () => {
            const blob = new Blob([output.value], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'transcript.txt';
            a.click();
        };
    </script>
</body>
</html>