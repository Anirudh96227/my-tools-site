---
// Tool 12: Live Captions
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Captions - My Tools</title>
    <style>
        :root {
            --primary: #2563eb;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
            --error: #ef4444;
        }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container { max-width: 800px; width: 100%; }
        header { margin-bottom: 2rem; text-align: center; }
        .tool-box {
            background: var(--card);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            border: 1px solid var(--border);
        }
        .tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
            padding-bottom: 0.5rem;
        }
        .tab-btn {
            padding: 0.5rem 1rem;
            border: none;
            background: none;
            cursor: pointer;
            font-weight: 500;
            color: #64748b;
            border-radius: 6px;
        }
        .tab-btn.active { background: var(--primary); color: white; }

        .progress-container { margin-bottom: 1.5rem; display: none; }
        .progress-bar { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
        .progress-fill { height: 100%; background: var(--primary); width: 0%; transition: width 0.3s; }
        .status-text { font-size: 0.85rem; color: #64748b; margin-top: 0.5rem; text-align: center; display: block; }

        .caption-display {
            background: #1e293b;
            color: #f8fafc;
            padding: 2rem;
            border-radius: 12px;
            min-height: 200px;
            max-height: 400px;
            overflow-y: auto;
            font-size: 1.25rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            position: relative;
        }
        .caption-display p { margin: 0 0 1rem 0; }
        .recording-indicator {
            position: absolute;
            top: 10px;
            right: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8rem;
            color: #94a3b8;
        }
        .dot { width: 10px; height: 10px; background: var(--error); border-radius: 50%; display: none; }
        .dot.active { display: block; animation: blink 1s infinite; }

        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

        .controls { display: flex; flex-direction: column; gap: 1rem; }
        .btn-primary {
            background: var(--primary);
            color: white;
            border: none;
            padding: 1rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-size: 1rem;
        }
        .btn-primary:disabled { opacity: 0.5; }
        .hidden { display: none; }
        .back-link { display: inline-block; margin-bottom: 1rem; color: var(--primary); text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← All Tools</a>
        <header>
            <h1>Live Captions</h1>
            <p>Real-time on-device captioning. No audio is ever sent to a server.</p>
        </header>

        <div class="tool-box">
            <div id="loadingUI" class="progress-container">
                <div class="progress-bar"><div id="progressFill" class="progress-fill"></div></div>
                <span id="statusText" class="status-text">Starting AI...</span>
            </div>

            <div id="mainUI" class="hidden">
                <div class="tabs">
                    <button class="tab-btn active" data-mode="live">Live Mic</button>
                    <button class="tab-btn" data-mode="video">Video File</button>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 500; color: #64748b; margin-bottom: 4px; display: block;">AI Task</label>
                        <select id="taskSelect" style="width: 100%; padding: 0.5rem; border-radius: 6px; border: 1px solid var(--border); background: white;">
                            <option value="transcribe">Transcribe (Same Language)</option>
                            <option value="translate">Translate (to English)</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 500; color: #64748b; margin-bottom: 4px; display: block;">Source Language</label>
                        <select id="langSelect" style="width: 100%; padding: 0.5rem; border-radius: 6px; border: 1px solid var(--border); background: white;">
                            <option value="auto">Auto-detect</option>
                            <option value="english">English</option>
                            <option value="spanish">Spanish</option>
                            <option value="french">French</option>
                            <option value="german">German</option>
                        </select>
                    </div>
                </div>

                <div class="caption-display" id="captionContainer">
                    <div class="recording-indicator">
                        <div id="recordDot" class="dot"></div>
                        <span id="recordStatus">Ready</span>
                    </div>
                    <div id="captionText">Click 'Start Captions' to begin...</div>
                </div>

                <div class="controls">
                    <div id="liveControls">
                        <button id="startBtn" class="btn-primary" style="width:100%">Start Captions</button>
                    </div>
                    <div id="videoControls" class="hidden">
                        <input type="file" id="videoInput" accept="video/*" class="hidden">
                        <button onclick="document.getElementById('videoInput').click()" class="btn-primary" style="width:100%">Upload Video File</button>
                    </div>
                    <button id="copyBtn" style="background:none; border: 1px solid var(--border); padding: 0.5rem; border-radius: 6px; cursor: pointer;">Copy All Captions</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const worker = new Worker('/workers/captions-worker.js', { type: 'module' });
        
        const loadingUI = document.getElementById('loadingUI');
        const mainUI = document.getElementById('mainUI');
        const progressFill = document.getElementById('progressFill');
        const statusText = document.getElementById('statusText');
        const captionText = document.getElementById('captionText');
        const captionContainer = document.getElementById('captionContainer');
        const recordDot = document.getElementById('recordDot');
        const recordStatus = document.getElementById('recordStatus');
        const startBtn = document.getElementById('startBtn');
        const videoInput = document.getElementById('videoInput');
        const copyBtn = document.getElementById('copyBtn');
        const taskSelect = document.getElementById('taskSelect');
        const langSelect = document.getElementById('langSelect');

        let isRecording = false;
        let mediaRecorder;
        let audioCtx;
        let currentMode = 'live';
        let fullTranscript = '';

        // Initialize model
        worker.postMessage({ type: 'load', model: 'Xenova/whisper-tiny' });
        loadingUI.style.display = 'block';

        worker.onmessage = (e) => {
            const data = e.data;
            if (data.type === 'progress') {
                progressFill.style.width = data.progress + '%';
                statusText.textContent = `Downloading AI model: ${Math.round(data.progress)}%`;
            } else if (data.type === 'loaded') {
                loadingUI.style.display = 'none';
                mainUI.classList.remove('hidden');
            } else if (data.type === 'result') {
                updateCaptions(data.text);
            } else if (data.type === 'status') {
                statusText.textContent = data.message;
            }
        };

        function updateCaptions(text) {
            if (!text.trim()) return;
            
            if (currentMode === 'live') {
                fullTranscript += ' ' + text;
                captionText.innerHTML += `<p>${text}</p>`;
                captionContainer.scrollTop = captionContainer.scrollHeight;
            } else {
                fullTranscript = text;
                captionText.innerHTML = `<p>${text}</p>`;
            }
        }

        // Tab Switching
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                if (isRecording) stopLive();
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentMode = btn.dataset.mode;
                document.getElementById('liveControls').classList.toggle('hidden', currentMode !== 'live');
                document.getElementById('videoControls').classList.toggle('hidden', currentMode !== 'video');
                captionText.innerHTML = currentMode === 'live' ? "Click 'Start Captions' to begin..." : "Upload a video to transcribe...";
                fullTranscript = '';
            });
        });

        // Live Mode Logic
        startBtn.onclick = async () => {
            if (!isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    
                    mediaRecorder.ondataavailable = async (e) => {
                        if (e.data.size > 0) {
                            const audioData = await convertBlobToAudioData(e.data);
                            worker.postMessage({ 
                                type: 'transcribe', 
                                audio: audioData,
                                task: taskSelect.value,
                                language: langSelect.value
                            });
                        }
                    };

                    // Request data every 5 seconds for "near-real-time"
                    mediaRecorder.start(5000);
                    isRecording = true;
                    startBtn.textContent = 'Stop Captions';
                    recordDot.classList.add('active');
                    recordStatus.textContent = 'Capturing...';
                    captionText.innerHTML = '';
                } catch (err) {
                    alert('Microphone access denied: ' + err.message);
                }
            } else {
                stopLive();
            }
        };

        function stopLive() {
            mediaRecorder?.stop();
            isRecording = false;
            startBtn.textContent = 'Start Captions';
            recordDot.classList.remove('active');
            recordStatus.textContent = 'Stopped';
        }

        // Video Mode Logic
        videoInput.onchange = async (e) => {
            const file = e.target.files[0];
            if (!file) return;

            captionText.innerHTML = "Processing video audio... Please wait.";
            const audioData = await convertBlobToAudioData(file);
            worker.postMessage({ 
                type: 'transcribe', 
                audio: audioData,
                task: taskSelect.value,
                language: langSelect.value
            });
        };

        async function convertBlobToAudioData(blob) {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
            
            const arrayBuffer = await blob.arrayBuffer();
            const decoded = await audioCtx.decodeAudioData(arrayBuffer);
            
            // Whisper requires mono 16kHz
            const offlineCtx = new OfflineAudioContext(1, decoded.duration * 16000, 16000);
            const source = offlineCtx.createBufferSource();
            source.buffer = decoded;
            source.connect(offlineCtx.destination);
            source.start();
            
            const resampled = await offlineCtx.startRendering();
            return resampled.getChannelData(0);
        }

        copyBtn.onclick = () => {
            const text = currentMode === 'live' ? fullTranscript : captionText.innerText;
            navigator.clipboard.writeText(text);
            alert('Captions copied to clipboard!');
        };
    </script>
</body>
</html>