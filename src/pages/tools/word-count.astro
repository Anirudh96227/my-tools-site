---
// Tool 1: Word Counter
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Word Counter - My Tools</title>
    <style>
        :root {
            --primary: #2563eb;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
        }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            max-width: 800px;
            width: 100%;
        }
        header {
            margin-bottom: 2rem;
            text-align: center;
        }
        .tool-box {
            background: var(--card);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            border: 1px solid var(--border);
        }
        textarea {
            width: 100%;
            height: 300px;
            padding: 1rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
            resize: vertical;
            box-sizing: border-box;
            margin-bottom: 1rem;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            background: var(--bg);
            padding: 1rem;
            border-radius: 8px;
            text-align: center;
            border: 1px solid var(--border);
        }
        .stat-value {
            display: block;
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary);
        }
        .stat-label {
            font-size: 0.875rem;
            color: #64748b;
        }
        .actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        button {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: 500;
            transition: opacity 0.2s;
        }
        .btn-primary { background: var(--primary); color: white; }
        .btn-outline { background: white; border: 1px solid var(--border); color: var(--text); }
        button:hover { opacity: 0.9; }
        .back-link {
            display: inline-block;
            margin-bottom: 1rem;
            color: var(--primary);
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← All Tools</a>
        <header>
            <h1>Word Counter</h1>
            <p>Analyze your text in real-time. No data leaves your device.</p>
        </header>

        <div class="tool-box">
            <textarea id="textInput" placeholder="Paste or type your text here..."></textarea>
            
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-value" id="wordCount">0</span>
                    <span class="stat-label">Words</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value" id="charCount">0</span>
                    <span class="stat-label">Chars (with spaces)</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value" id="charNoSpaceCount">0</span>
                    <span class="stat-label">Chars (no spaces)</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value" id="sentenceCount">0</span>
                    <span class="stat-label">Sentences</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value" id="paragraphCount">0</span>
                    <span class="stat-label">Paragraphs</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value" id="readTime">0m</span>
                    <span class="stat-label">Reading Time</span>
                </div>
            </div>

            <div class="actions">
                <button class="btn-primary" id="copyBtn">Copy Text</button>
                <button class="btn-outline" id="clearBtn">Clear</button>
            </div>
        </div>
    </div>

    <script>
        const textarea = document.getElementById('textInput');
        const stats = {
            words: document.getElementById('wordCount'),
            chars: document.getElementById('charCount'),
            charsNoSpace: document.getElementById('charNoSpaceCount'),
            sentences: document.getElementById('sentenceCount'),
            paragraphs: document.getElementById('paragraphCount'),
            readTime: document.getElementById('readTime')
        };

        textarea.addEventListener('input', () => {
            const text = textarea.value;
            
            const words = text.trim() ? text.trim().split(/\s+/).length : 0;
            const chars = text.length;
            const charsNoSpace = text.replace(/\s/g, '').length;
            const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
            const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;
            const readingTime = Math.ceil(words / 200);

            stats.words.textContent = words;
            stats.chars.textContent = chars;
            stats.charsNoSpace.textContent = charsNoSpace;
            stats.sentences.textContent = sentences;
            stats.paragraphs.textContent = paragraphs;
            stats.readTime.textContent = readingTime + 'm';
        });

        document.getElementById('clearBtn').addEventListener('click', () => {
            textarea.value = '';
            textarea.dispatchEvent(new Event('input'));
        });

        document.getElementById('copyBtn').addEventListener('click', () => {
            navigator.clipboard.writeText(textarea.value);
        });
    </script>
</body>
</html>